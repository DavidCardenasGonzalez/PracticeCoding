{
  "name": "node-senior-challenges",
  "version": "0.1.0",
  "private": true,
  "description": "Advanced Node.js exercises for senior technical interviews and real-world scenarios.",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:message-queue": "vitest run exercises/message-queue/tests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vitest": "^4.1.10"
  }
}
