{
  "name": "node-senior-challenges",
  "version": "0.1.0",
  "private": true,
  "description": "Advanced TypeScript, Node.js, and React exercises for senior technical interviews and real-world scenarios.",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:message-queue": "vitest run exercises/message-queue/tests",
    "test:react": "vitest run exercises/async-combobox/tests",
    "test:react:watch": "vitest exercises/async-combobox/tests",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
